{
  "name": "softeng-inventaris",
  "private": true,
  "version": "0.1.0",
  "description": "Sistem Inventaris Multi Cabang",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:be": "npm run dev --workspace backend",
    "dev:fe": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:reset": "npm run db:reset --workspace backend"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
